{
  "name": "the-mens-formula",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check-all": "pnpm type-check && pnpm lint && pnpm format",
    "fix-all": "pnpm format:fix && pnpm lint:fix && pnpm test:update-snapshots",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "catalog:generate-migration": "node scripts/generate-catalog-migration.mjs",
    "catalog:refresh-from-excel": "node scripts/generate-catalog-refresh-migration.mjs",
    "catalog:prepare-images": "node scripts/prepare-product-images.mjs",
    "catalog:upload-images": "node --env-file=.env.local scripts/upload-product-images.mjs",
    "catalog:migrate-images": "node --env-file=.env.local scripts/migrate-product-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "node --env-file=.env.local -e \"process.env.PLAYWRIGHT_BASE_URL='http://localhost:3000'; require('child_process').spawnSync(process.execPath,['./node_modules/@playwright/test/cli.js','test'],{stdio:'inherit',env:process.env})\"",
    "test:update-snapshots": "vitest run -u"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "^10.75.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.0",
    "xlsx": "0.18.5"
  },
  "packageManager": "pnpm@11.27.0",
  "volta": {
    "node": "24.21.0",
    "pnpm": "11.27.0"
  }
}
